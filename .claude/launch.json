{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "pnpm@9.15.0",
        "--filter",
        "@hanoi-monopoly/server",
        "start"
      ],
      "port": 2567
    },
    {
      "name": "client",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "pnpm@9.15.0",
        "--filter",
        "@hanoi-monopoly/client",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "packages/server/dist/server.mjs"
      ],
      "env": {
        "PORT": "8080"
      },
      "port": 8080
    }
  ]
}
