# itch.io build: `pnpm --filter @hanoi-monopoly/client run build:itch`.
# itch.io serves the files from its own domain, so both addresses are explicit:
# the game server, and the website that invite links point to.
VITE_SERVER_URL=wss://hanoi-monopoly.onrender.com
VITE_PUBLIC_URL=https://hanoi-monopoly.onrender.com/
